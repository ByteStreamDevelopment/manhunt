# Kopiere diese Datei nach .env und setze ein langes, zufälliges Passwort.
ADMIN_PASSWORD=bitte-aendern

# Optional: Fingerabdruck des App-Signierschlüssels (gibt android/build.sh aus).
# Dann öffnen Einladungslinks /g/CODE direkt die Android-App.
ANDROID_CERT_SHA256=

# E-Mail-Versand (Bestätigungscodes, Passwort vergessen). Ohne SMTP_HOST stehen die Codes nur im Server-Log.
# Beispiel STARTTLS: SMTP_PORT=587 SMTP_SECURE=false, Beispiel SSL: SMTP_PORT=465 SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# VPN-Erkennung zusätzlich über die IP-Adresse (ip-api.com, nur nicht-kommerziell kostenlos): off | ipapi
VPN_CHECK=off

# Speicherkontingent pro Account (MB) für Fotos/Sprachnachrichten eigener Runden, offene Runden pro Account, max. Laufzeit
# USER_QUOTA_MB=1024
# MAX_OPEN_GAMES=3
# MAX_GAME_HOURS=24
# Fotos beendeter Runden nach X Tagen löschen (0 = nie)
# PHOTO_RETENTION_DAYS=30
# Angaben für Impressum und Datenschutzerklärung (Pflicht für den öffentlichen Betrieb!)
# OPERATOR_NAME=Vorname Nachname
# OPERATOR_ADDRESS=Straße 1 | 12345 Ort
# OPERATOR_EMAIL=kontakt@example.org
# OPERATOR_PHONE=
# Unbestätigte Registrierungen nach X Tagen löschen
# UNVERIFIED_DAYS=7
